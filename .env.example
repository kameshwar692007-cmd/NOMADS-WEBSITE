# Nomad's Province — Environment Configuration Template
# Copy this file to .env and fill in your Supabase Free Project credentials.
# In Vercel, add these same variables under Project Settings -> Environment Variables.

# Supabase Free Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Free Project Public Anon Key (Never use the service_role key here!)
VITE_SUPABASE_ANON_KEY=
